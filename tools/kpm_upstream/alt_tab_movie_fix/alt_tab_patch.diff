+// KotOR plays a movie in its own window, "SW Movie Player Window", and switches the display to
+// the movie's mode (640x480) for it. While that window is up the display mode is the movie's:
+// restoring the game's resolution under it leaves the movie drawn in the top-left corner of a
+// full-resolution screen.
+bool moviePlaying() {
+    const HWND movieWindow = FindWindowA(nullptr, "SW Movie Player Window");
+    if (movieWindow == nullptr || !IsWindowVisible(movieWindow)) {
+        return false;
+    }
+    DWORD movieProcessId = 0;
+    GetWindowThreadProcessId(movieWindow, &movieProcessId);
+    return movieProcessId == GetCurrentProcessId();
+}
