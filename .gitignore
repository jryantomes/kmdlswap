.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
/logs/
*_pykotor.log
/out/
/scratch/
/corpus/
/reports/*.json
/reports/*.csv
/out_probe/
/out_m3/
/out_fbx/
/reports/support_matrix.json
/reports/catalogue.json
# Diagnostic renders. Every one is a picture of BioWare's own geometry - faces,
# heads, characters on game bodies - and this repository already needs its
# history scrubbed of game data before it can go public. They are reproducible
# from the scripts that drew them, so there is nothing to keep.
/reports/*.png
/catalogue/
/catalogue_*/
/out_swap/
/out_fun/
/out_tripo/
/out_probe2/
/out_caps/
/packs/
# Build outputs. These carry whole `appearance.2da` and `heads.2da` tables
# copied out of a person's own install, plus models derived from vanilla
# geometry - none of which belongs in a repository. `out_broker*` was committed
# by accident because the pattern list named specific folders rather than the
# prefix every build actually uses.
/out_*/

# my own working files while patching
/scratch_patch.py

# Generated lip files
/lips_out/
/lips_check/

# Personal Claude Code permissions - machine-local, not the project's business
.claude/settings.local.json

# Bundled builds. 76MB of somebody else's libraries, reproducible from the
# spec in one command, and not the kind of thing a repository should carry.
/dist/
/build/
*.spec.bak

# Built models. Output of the tool, reproducible in one command, and game
# geometry besides - the same reason the diagnostic renders are not carried.
/builds/

# PO-12 GH0-RFK build outputs: models, textures, renders and vanilla GUI
# portraits, all game-derived. Reproducible from tools/swtor_po12/README.md.
/tools/swtor_po12/rfk_build*/
/tools/swtor_po12/rfk_portraits*/
/tools/swtor_po12/gui/
# ...and rebuild_chain.py's <prefix>_* chains (rfk_e_ eye halo, rfk_m_ mouth light, rfk_o_ replay)
/tools/swtor_po12/rfk_[a-z]_*/

# PyKotor writes logs next to the scripts it runs
tools/*/logs/
tools/logs/
tools/*/scripts/logs/

# flow.py writes its scenario on every run (flow_<plan>.nss); the plans in flow.py are the source
/tools/kotor_autotest/scenarios/flow_*.nss

# gh0_units.py's working chain for the GH0 units (models, textures, check renders): game-derived,
# rebuilt by tools/swtor_po12/gh0_units.py
/tools/swtor_po12/gh0s_work/
# crashwatch.py's run logs
/tools/kotor_autotest/crashwatch.log
/tools/kotor_autotest/crashwatch_run.txt
